 # ==============================================================================
# ApexLead AI - Environment Configuration & Free-Only Policy
# ==============================================================================
# Strict Policy: ApexLead AI is configured by default for 100% Free & Open-Source
# discovery. No credit card, billable requests, or commercial subscriptions needed.
# ==============================================================================

# ── CENTRAL FREE-ONLY POLICY ENFORCEMENT ──────────────────────────────────────
# When true, all integrations without confirmed, cardless free allowances are strictly blocked.
FREE_ONLY_MODE=true

# ── SERVER CONFIGURATION ──────────────────────────────────────────────────────
PORT=8005
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── COMMERCIAL INTEGRATION FLAGS (DISABLED BY DEFAULT) ────────────────────────
# Even if API keys are set, commercial services are disabled unless explicitly set to true.
# In FREE_ONLY_MODE=true, any provider without a cardless free tier remains blocked.

# Hunter.io: Active free tier of 25 searches/month (No credit card required).
ENABLE_HUNTER=false
HUNTER_API_KEY=

# Tomba.io: Active free tier of 25 searches/month (No credit card required).
# Auth headers: X-Tomba-Key + X-Tomba-Secret. Base: https://api.tomba.io/v1
ENABLE_TOMBA=false
TOMBA_API_KEY=
TOMBA_SECRET_KEY=
TOMBA_API_BASE=https://api.tomba.io/v1

# Apollo.io: Commercial API. Auth: x-api-key header. Base: https://api.apollo.io/api/v1
ENABLE_APOLLO=false
APOLLO_API_KEY=
APOLLO_API_BASE=https://api.apollo.io/api/v1

# Other Commercial Providers (Pay-per-lookup or trial requiring credit card; BLOCKED by default):
ENABLE_PROXYCURL=false
PROXYCURL_API_KEY=

ENABLE_PDL=false
PDL_API_KEY=

ENABLE_CONTACTOUT=false
CONTACTOUT_API_KEY=

ENABLE_ROCKETREACH=false
ROCKETREACH_API_KEY=

# ── RATE LIMITING & SECURITY ──────────────────────────────────────────────────
RATE_LIMIT_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=15
